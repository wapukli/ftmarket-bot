[Unit]
Description=FTmarket Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ftmarket/server
EnvironmentFile=/home/ubuntu/ftmarket/server/.env
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/ftmarket/bot.log
StandardError=append:/home/ubuntu/ftmarket/bot-error.log

[Install]
WantedBy=multi-user.target
